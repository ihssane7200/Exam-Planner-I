{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C Backend",
            "type": "shell",
            "command": "make",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Run C Backend",
            "type": "shell",
            "command": "./build/exam_planner --serve",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "dependsOn": ["Build C Backend"],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Clean Build",
            "type": "shell",
            "command": "make clean && make",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run Tests",
            "type": "shell",
            "command": "make test",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Install Frontend Dependencies",
            "type": "shell",
            "command": "npm install",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            }
        },
        {
            "label": "Run Frontend Dev Server",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "problemMatcher": []
        }
    ]
}
