{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug C Backend",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/backend/build/exam_planner",
            "args": ["--serve", "8080"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/backend",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build C Backend",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}
